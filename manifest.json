{
  "manifest_version": 3,
  "name": "PiPDesk \u2014 Picture-in-Picture Workspace",
  "version": "0.2.0",
  "description": "Keep a tab, a page region, your notes, your to-dos or a focus timer floating on top of whatever you are working on.",
  "author": "dinhtuandev",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PiPDesk",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "float-tab": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Float the current tab"
    },
    "float-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Float a selected region"
    },
    "stop-all": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop every floating source"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/float-control.js", "content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "use_dynamic_url": true,
      "resources": [
        "panels/notes.html",
        "panels/todos.html",
        "panels/timer.html"
      ]
    }
  ]
}
